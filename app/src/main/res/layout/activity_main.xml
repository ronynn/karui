<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- WebView sits at the BOTTOM of the stack (added first).
         It is VISIBLE from onCreate — it paints the theme background
         while loading, hidden behind the opaque splash above. -->
    <WebView
        android:id="@+id/activity_main_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Splash on TOP. Opaque black. Fades out from onPageFinished to
         reveal the WebView beneath — a real cross-fade, not a pop. -->
    <RelativeLayout
        android:id="@+id/splash_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INITIALIZING RONYNN OS"
            android:textColor="#ebdbb2"/>

    </RelativeLayout>

</RelativeLayout>