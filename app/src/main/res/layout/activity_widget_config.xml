<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:padding="16dp"
  android:background="#121212">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Widget Settings"
      android:textColor="#FFFFFF"
      android:textSize="18sp"
      android:textStyle="bold"
      android:paddingBottom="16dp" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Select Tab to Display:"
      android:textColor="#CCCCCC"
      android:paddingBottom="4dp" />

    <Spinner
      android:id="@+id/spinner_tabs"
      android:layout_width="match_parent"
      android:layout_height="48dp"
      android:paddingBottom="12dp" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Background Transparency:"
      android:textColor="#CCCCCC"
      android:paddingTop="12dp"
      android:paddingBottom="4dp" />

    <SeekBar
      android:id="@+id/seekbar_transparency"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:max="100"
      android:progress="15" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Font Style:"
      android:textColor="#CCCCCC"
      android:paddingTop="16dp"
      android:paddingBottom="4dp" />

    <RadioGroup
      android:id="@+id/radiogroup_font"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:paddingBottom="20dp">

      <RadioButton
        android:id="@+id/radio_font_default"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Default"
        android:textColor="#FFFFFF"
        android:checked="true" />

      <RadioButton
        android:id="@+id/radio_font_mono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Monospace"
        android:textColor="#FFFFFF"
        android:layout_marginStart="24dp" />
    </RadioGroup>

    <Button
      android:id="@+id/btn_save_widget_config"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Save Widget" />

  </LinearLayout>
</ScrollView>