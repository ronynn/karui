<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="8dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingBottom="6dp">

    <TextView
      android:id="@+id/widget_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="Notes"
      android:textColor="#FFFFFF"
      android:textSize="16sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_sort_btn"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:paddingTop="2dp"
      android:paddingBottom="2dp"
      android:text="√s"
      android:textColor="#FFFFFF"
      android:textSize="13sp"
      android:background="@drawable/widget_button_bg" />

    <TextView
      android:id="@+id/widget_refresh_btn"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:paddingTop="2dp"
      android:paddingBottom="2dp"
      android:text="√r"
      android:textColor="#FFFFFF"
      android:textSize="13sp"
      android:background="@drawable/widget_button_bg" />

    <TextView
      android:id="@+id/widget_settings_btn"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="4dp"
      android:paddingStart="6dp"
      android:paddingEnd="6dp"
      android:paddingTop="2dp"
      android:paddingBottom="2dp"
      android:text="√m"
      android:textColor="#FFFFFF"
      android:textSize="13sp"
      android:background="@drawable/widget_button_bg" />

  </LinearLayout>

  <ListView
    android:id="@+id/widget_list_view"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:divider="@null"
    android:dividerHeight="0dp" />

  <TextView
    android:id="@+id/widget_empty_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:text="No notes found! Set up sync and then select a tab. \n -ronynn"
    android:textColor="#AAAAAA"
    android:visibility="gone" />

</LinearLayout>